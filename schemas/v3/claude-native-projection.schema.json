{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juhjuhx/agent-skills/schemas/v3/claude-native-projection.schema.json",
  "title": "Agent Skills Matrix v3 ClaudeNativeProjection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "projection_version",
    "runtime_id",
    "bundle_digest",
    "support_levels",
    "instruction_surfaces",
    "skills",
    "config",
    "invocation",
    "permissions",
    "mcp",
    "plugins",
    "hooks",
    "subagents",
    "context",
    "provenance",
    "no_ask_proof"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "projection_version": {"$ref": "common.schema.json#/$defs/shortString"},
    "runtime_id": {"type": "string", "const": "claude-code"},
    "bundle_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "support_levels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CLAUDE.md", "Skills", "skill_body_delivery", "Hooks", "Subagents", "Plugins", "MCP", "config", "permission_mode", "tools", "output_format", "safe_mode", "model", "effort", "static_context", "dynamic_context", "tool_schema_context", "evidence_gate"],
      "properties": {
        "CLAUDE.md": {"$ref": "#/$defs/supportLevel"},
        "Skills": {"$ref": "#/$defs/supportLevel"},
        "skill_body_delivery": {"$ref": "#/$defs/supportLevel"},
        "Hooks": {"$ref": "#/$defs/supportLevel"},
        "Subagents": {"$ref": "#/$defs/supportLevel"},
        "Plugins": {"$ref": "#/$defs/supportLevel"},
        "MCP": {"$ref": "#/$defs/supportLevel"},
        "config": {"$ref": "#/$defs/supportLevel"},
        "permission_mode": {"$ref": "#/$defs/supportLevel"},
        "tools": {"$ref": "#/$defs/supportLevel"},
        "output_format": {"$ref": "#/$defs/supportLevel"},
        "safe_mode": {"$ref": "#/$defs/supportLevel"},
        "model": {"$ref": "#/$defs/supportLevel"},
        "effort": {"$ref": "#/$defs/supportLevel"},
        "static_context": {"$ref": "#/$defs/supportLevel"},
        "dynamic_context": {"$ref": "#/$defs/supportLevel"},
        "tool_schema_context": {"$ref": "#/$defs/supportLevel"},
        "evidence_gate": {"$ref": "#/$defs/supportLevel"}
      }
    },
    "instruction_surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistent"],
      "properties": {
        "persistent": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "scope", "purposes"],
            "properties": {
              "path": {"$ref": "common.schema.json#/$defs/relativePath"},
              "scope": {"type": "string", "enum": ["project", "user", "system"]},
              "purposes": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/shortString"}, "uniqueItems": true}
            }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["load_mode", "native_surface", "selected", "body_files_loaded"],
      "properties": {
        "load_mode": {"type": "string", "const": "selected-only"},
        "native_surface": {"type": "string", "enum": ["NATIVE", "HOST_MANAGED", "UNSUPPORTED"]},
        "selected": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["skill_id", "source_ref", "source_path", "digest", "role", "trust", "load_state"],
            "properties": {
              "skill_id": {"$ref": "common.schema.json#/$defs/recordId"},
              "source_ref": {"$ref": "common.schema.json#/$defs/shortString"},
              "source_path": {"$ref": "common.schema.json#/$defs/relativePath"},
              "digest": {"$ref": "common.schema.json#/$defs/digest"},
              "role": {"$ref": "common.schema.json#/$defs/role"},
              "trust": {"$ref": "common.schema.json#/$defs/trust"},
              "load_state": {"type": "string", "enum": ["RESIDENT", "LOADED", "NOT_LOADED"]}
            }
          }
        },
        "body_files_loaded": {"type": "integer", "const": 0}
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "values"],
      "properties": {
        "surface": {"type": "string", "const": "CLI_FLAGS"},
        "values": {"$ref": "#/$defs/configValues"}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "output_format", "permission_mode", "tools", "allowed_tools", "safe_mode", "no_session_persistence", "no_chrome", "strict_mcp_config", "disable_slash_commands", "shell", "stdin", "cwd_mode", "timeout_ms", "auto", "raw_prompt_serialized", "raw_skill_bodies_serialized"],
      "properties": {
        "command": {"type": "string", "const": "claude -p"},
        "output_format": {"type": "string", "const": "json"},
        "permission_mode": {"type": "string", "const": "dontAsk"},
        "tools": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/shortString"}, "uniqueItems": true},
        "allowed_tools": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/shortString"}, "uniqueItems": true},
        "safe_mode": {"type": "boolean", "const": true},
        "no_session_persistence": {"type": "boolean", "const": true},
        "no_chrome": {"type": "boolean", "const": true},
        "strict_mcp_config": {"type": "boolean", "const": true},
        "disable_slash_commands": {"type": "boolean", "const": true},
        "shell": {"type": "boolean", "const": false},
        "stdin": {"type": "string", "const": "DEVNULL"},
        "cwd_mode": {"type": "string", "const": "ISOLATED_FIXTURE"},
        "timeout_ms": {"type": "integer", "minimum": 1},
        "max_budget_usd": {"type": "number", "minimum": 0},
        "auto": {"type": "boolean", "const": false},
        "raw_prompt_serialized": {"type": "boolean", "const": false},
        "raw_skill_bodies_serialized": {"type": "boolean", "const": false}
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filesystem", "classification", "native_scope", "reason", "explicit_denials"],
      "properties": {
        "filesystem": {"type": "string", "enum": ["none", "read", "workspace-read"]},
        "classification": {"type": "string", "enum": ["NATIVE_EXACT", "HOST_MANAGED", "BLOCKED"]},
        "native_scope": {"type": "string", "enum": ["ISOLATED_FIXTURE", "NONE"]},
        "reason": {"$ref": "common.schema.json#/$defs/shortString"},
        "explicit_denials": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/shortString"}, "minItems": 1, "uniqueItems": true}
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "refs", "schema_loaded"],
      "properties": {
        "status": {"type": "string", "const": "DENY"},
        "refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/recordId"}, "maxItems": 0},
        "schema_loaded": {"type": "boolean", "const": false}
      }
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "refs"],
      "properties": {
        "status": {"type": "string", "const": "DENY"},
        "refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/recordId"}, "maxItems": 0}
      }
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "refs"],
      "properties": {
        "status": {"type": "string", "const": "DISABLED"},
        "refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/recordId"}, "maxItems": 0}
      }
    },
    "subagents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "refs"],
      "properties": {
        "status": {"type": "string", "const": "DENY"},
        "refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/recordId"}, "maxItems": 0}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static_prefix", "dynamic_context", "tool_schema_context", "artifact_refs"],
      "properties": {
        "static_prefix": {"$ref": "#/$defs/supportLevel"},
        "dynamic_context": {"$ref": "#/$defs/supportLevel"},
        "tool_schema_context": {"$ref": "#/$defs/supportLevel"},
        "artifact_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/recordId"}, "uniqueItems": true}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_digest", "runtime_id", "observed_runtime_version", "release_tag", "release_commit", "contract_target", "contract_source_commit", "native_contract_revision", "contract_digest", "docs_snapshot_date", "verification_method", "availability", "support", "selected_skill_digests"],
      "properties": {
        "bundle_digest": {"$ref": "common.schema.json#/$defs/digest"},
        "runtime_id": {"$ref": "common.schema.json#/$defs/runtimeId"},
        "observed_runtime_version": {"$ref": "common.schema.json#/$defs/shortString"},
        "release_tag": {"type": ["string", "null"], "maxLength": 200},
        "release_commit": {"type": ["string", "null"], "maxLength": 200},
        "contract_target": {"type": "string", "enum": ["INSTALLED_RUNTIME", "SOURCE_SNAPSHOT", "DOCUMENTATION_SNAPSHOT"]},
        "contract_source_commit": {"type": ["string", "null"], "maxLength": 200},
        "native_contract_revision": {"$ref": "common.schema.json#/$defs/shortString"},
        "contract_digest": {"$ref": "common.schema.json#/$defs/digest"},
        "docs_snapshot_date": {"$ref": "common.schema.json#/$defs/shortString"},
        "verification_method": {"$ref": "common.schema.json#/$defs/shortString"},
        "availability": {"type": "string", "enum": ["INSTALLED", "RELEASE_SUPPORTED", "UPSTREAM_ONLY", "UNKNOWN"]},
        "support": {"$ref": "#/$defs/supportLevel"},
        "selected_skill_digests": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/digest"}, "uniqueItems": true}
      }
    },
    "no_ask_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_ask", "required_actions", "resolved_actions", "method"],
      "properties": {
        "no_ask": {"type": "boolean", "const": true},
        "required_actions": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/shortString"}, "uniqueItems": true},
        "resolved_actions": {"type": "object", "additionalProperties": {"type": "string", "enum": ["ALLOW", "DENY"]}},
        "method": {"$ref": "common.schema.json#/$defs/shortString"}
      }
    }
  },
  "$defs": {
    "supportLevel": {"type": "string", "enum": ["NATIVE", "HOST_MANAGED", "UNSUPPORTED"]},
    "configValues": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permission_mode", "tools", "allowed_tools", "output_format", "max_budget_usd", "no_session_persistence", "no_chrome", "safe_mode", "strict_mcp_config", "mcp_config", "disable_slash_commands"],
      "properties": {
        "permission_mode": {"type": "string", "const": "dontAsk"},
        "tools": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/shortString"}, "uniqueItems": true},
        "allowed_tools": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/shortString"}, "uniqueItems": true},
        "output_format": {"type": "string", "const": "json"},
        "max_budget_usd": {"type": "number", "minimum": 0},
        "no_session_persistence": {"type": "boolean", "const": true},
        "no_chrome": {"type": "boolean", "const": true},
        "safe_mode": {"type": "boolean", "const": true},
        "strict_mcp_config": {"type": "boolean", "const": true},
        "mcp_config": {"type": "string", "const": "{\"mcpServers\":{}}"},
        "disable_slash_commands": {"type": "boolean", "const": true}
      }
    }
  }
}
