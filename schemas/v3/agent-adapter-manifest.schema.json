{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juhjuhx/agent-skills/schemas/v3/agent-adapter-manifest.schema.json",
  "title": "Agent Skills Matrix v3 AgentAdapterManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runtime_id",
    "manifest_version",
    "instruction_surfaces",
    "skill_discovery",
    "capabilities",
    "permissions",
    "context_behavior",
    "generated_config",
    "security_constraints"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "runtime_id": {"$ref": "common.schema.json#/$defs/runtimeId"},
    "runtime_name": {"$ref": "common.schema.json#/$defs/shortString"},
    "manifest_version": {"$ref": "common.schema.json#/$defs/shortString"},
    "instruction_surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persistent"],
      "properties": {
        "persistent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths", "purposes"],
          "properties": {
            "paths": {
              "type": "array",
              "items": {"$ref": "common.schema.json#/$defs/relativePath"},
              "minItems": 1,
              "uniqueItems": true
            },
            "purposes": {
              "type": "array",
              "items": {"type": "string", "enum": ["invariants", "routing-bootstrap", "context-policy", "project-context"]},
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        "session": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/relativePath"}
        }
      }
    },
    "skill_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_paths", "lazy_loading", "selected_refs_only"],
      "properties": {
        "native_paths": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/relativePath"},
          "uniqueItems": true
        },
        "lazy_loading": {"type": "boolean"},
        "compatibility_paths": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/relativePath"},
          "uniqueItems": true
        },
        "selected_refs_only": {"type": "boolean"}
      }
    },
    "commands": {"$ref": "#/$defs/surface"},
    "subagents": {"$ref": "#/$defs/surface"},
    "plugins": {"$ref": "#/$defs/surface"},
    "hooks": {"$ref": "#/$defs/surface"},
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "lazy_loading", "schema_cost_tracked"],
      "properties": {
        "supported": {"type": "boolean"},
        "lazy_loading": {"type": "boolean"},
        "schema_cost_tracked": {"type": "boolean"},
        "server_refs": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/recordId"},
          "uniqueItems": true
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_gated"],
      "properties": {
        "policy_gated": {"type": "boolean"},
        "supports_profiles": {"type": "boolean"},
        "declared_scopes": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/shortString"},
          "uniqueItems": true
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supported": {"type": "boolean"},
        "modes": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/shortString"},
          "uniqueItems": true
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "properties": {
        "editing": {"type": "boolean"},
        "browser": {"type": "boolean"},
        "subagents": {"type": "boolean"},
        "sandbox": {"type": "boolean"},
        "MCP": {"type": "boolean"},
        "structured_output": {"type": "boolean"},
        "parallelism": {"type": "boolean"},
        "native_learning": {"type": "boolean"},
        "model_selection": {"type": "boolean"},
        "reasoning_effort": {"type": "boolean"},
        "long_context": {"type": "boolean"},
        "multimodal": {"type": "boolean"}
      }
    },
    "model_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_based"],
      "properties": {
        "profile_based": {"type": "boolean"},
        "per_agent": {"type": "boolean"},
        "universal_model_ids": {"type": "boolean"}
      }
    },
    "reasoning_effort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native", "artifact_contract"],
      "properties": {
        "native": {"type": "boolean"},
        "artifact_contract": {"type": "boolean"},
        "levels": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/shortString"},
          "uniqueItems": true
        }
      }
    },
    "parallelism": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supported": {"type": "boolean"},
        "max_parallel": {"type": "integer", "minimum": 0},
        "requires_disjoint_write_set": {"type": "boolean"}
      }
    },
    "context_behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "static_prompt_prefix",
        "dynamic_runtime_context",
        "tool_schema_budget",
        "tool_ordering",
        "cache_stability"
      ],
      "properties": {
        "static_prompt_prefix": {"type": "string", "enum": ["stable", "variable", "unknown"]},
        "dynamic_runtime_context": {"type": "string", "enum": ["lazy", "eager", "unknown"]},
        "tool_schema_budget": {"type": "string", "enum": ["tracked", "untracked", "unknown"]},
        "tool_ordering": {"type": "string", "enum": ["stable", "runtime", "unknown"]},
        "cache_stability": {"type": "string", "enum": ["stable-prefix", "best-effort", "unknown"]}
      }
    },
    "generated_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported", "outputs", "records_provenance"],
      "properties": {
        "supported": {"type": "boolean"},
        "outputs": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/relativePath"},
          "uniqueItems": true
        },
        "records_provenance": {"type": "boolean"}
      }
    },
    "security_constraints": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/shortString"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supported"],
      "properties": {
        "supported": {"type": "boolean"},
        "native_refs": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/relativePath"},
          "uniqueItems": true
        },
        "lazy_loading": {"type": "boolean"},
        "definitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": {"$ref": "common.schema.json#/$defs/recordId"},
              "purpose": {"$ref": "common.schema.json#/$defs/shortString"},
              "requires_permission": {"type": "boolean"},
              "reference": {"$ref": "common.schema.json#/$defs/relativePath"}
            }
          }
        }
      }
    }
  }
}
