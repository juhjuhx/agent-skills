{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juhjuhx/agent-skills/schemas/v3/evaluation-run.schema.json",
  "title": "Agent Skills Matrix v3 EvaluationRun",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "fixture_id",
    "fixture_set",
    "task_spec_ref",
    "stage_route_refs",
    "runtime_candidate_ref",
    "evidence_class",
    "execution_mode",
    "repetition",
    "status",
    "history_mode"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "run_id": {"$ref": "common.schema.json#/$defs/recordId"},
    "fixture_id": {"$ref": "common.schema.json#/$defs/recordId"},
    "fixture_set": {"type": "string", "enum": ["DEVELOPMENT", "HOLDOUT"]},
    "task_spec_ref": {"$ref": "common.schema.json#/$defs/recordId"},
    "stage_route_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/recordId"}, "minItems": 1, "uniqueItems": true},
    "execution_configuration_ref": {"type": ["string", "null"]},
    "runtime_candidate_ref": {"$ref": "common.schema.json#/$defs/recordId"},
    "model_candidate_ref": {"type": ["string", "null"]},
    "selection_scope": {"type": "string", "enum": ["TASK_DEFAULT", "STAGE", "SUBAGENT", "TASK_PINNED"]},
    "evidence_class": {"$ref": "common.schema.json#/$defs/evidenceClass"},
    "execution_mode": {"type": "string", "enum": ["REAL_EXECUTION", "HOST_MANAGED_FIXTURE", "MOCK", "UNAVAILABLE"]},
    "repetition": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["PLANNED", "RUNNING", "COMPLETED", "FAILED", "BLOCKED"]},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "input_artifact_digests": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/digest"}, "uniqueItems": true},
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "duration_ms": {"type": ["number", "null"], "minimum": 0},
        "model_calls": {"type": ["integer", "null"], "minimum": 0},
        "tool_calls": {"type": ["integer", "null"], "minimum": 0},
        "context_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tokens_total": {"type": ["integer", "null"], "minimum": 0},
        "cost_units": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "history_mode": {"type": "string", "const": "APPEND_ONLY"},
    "sensitive_data_serialized": {"type": "boolean", "const": false}
  }
}
