{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juhjuhx/agent-skills/schemas/v3/claude-native-contract.schema.json",
  "title": "Agent Skills Matrix v3 Claude Native Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "runtime_id",
    "observed_runtime_version",
    "release_tag",
    "release_commit",
    "release_date",
    "contract_target",
    "contract_source_commit",
    "docs_snapshot_date",
    "contract_digest",
    "verification_method",
    "support",
    "availability",
    "native_contract_revision",
    "source_files",
    "scope",
    "update_process",
    "authentication_categories",
    "surfaces",
    "fields"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "contract_version": {"$ref": "common.schema.json#/$defs/shortString"},
    "runtime_id": {"type": "string", "const": "claude-code"},
    "observed_runtime_version": {"$ref": "common.schema.json#/$defs/shortString"},
    "release_tag": {"type": ["string", "null"], "maxLength": 200},
    "release_commit": {"type": ["string", "null"], "maxLength": 200},
    "release_date": {"type": ["string", "null"], "maxLength": 80},
    "contract_target": {"$ref": "#/$defs/contractTarget"},
    "contract_source_commit": {"type": ["string", "null"], "maxLength": 200},
    "docs_snapshot_date": {"$ref": "common.schema.json#/$defs/shortString"},
    "contract_digest": {"$ref": "common.schema.json#/$defs/digest"},
    "verification_method": {"$ref": "common.schema.json#/$defs/shortString"},
    "support": {"$ref": "common.schema.json#/$defs/supportLevel"},
    "availability": {"$ref": "#/$defs/availability"},
    "native_contract_revision": {"$ref": "common.schema.json#/$defs/shortString"},
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/relativePath"},
      "uniqueItems": true
    },
    "scope": {"$ref": "common.schema.json#/$defs/shortString"},
    "update_process": {"$ref": "common.schema.json#/$defs/shortString"},
    "authentication_categories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["SUBSCRIPTION_OAUTH", "API_KEY", "BEDROCK", "VERTEX", "FOUNDRY", "UNKNOWN"]
      },
      "uniqueItems": true
    },
    "surfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/surface"
      }
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "$defs": {
    "contractTarget": {
      "type": "string",
      "enum": ["INSTALLED_RUNTIME", "SOURCE_SNAPSHOT", "DOCUMENTATION_SNAPSHOT"]
    },
    "availability": {
      "type": "string",
      "enum": ["INSTALLED", "RELEASE_SUPPORTED", "UPSTREAM_ONLY", "UNKNOWN"]
    },
    "supportLevel": {
      "type": "string",
      "enum": ["NATIVE", "EMULATED", "HOST_MANAGED", "UNSUPPORTED"]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["support", "availability"],
      "properties": {
        "support": {"$ref": "#/$defs/supportLevel"},
        "availability": {"$ref": "#/$defs/availability"},
        "notes": {"$ref": "common.schema.json#/$defs/shortString"}
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "cli_flag"],
      "properties": {
        "type": {"type": "string", "enum": ["string", "array", "boolean", "integer", "number"]},
        "cli_flag": {"$ref": "common.schema.json#/$defs/shortString"},
        "enum": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/shortString"}, "uniqueItems": true},
        "items_enum": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/shortString"}, "uniqueItems": true},
        "exact": {"type": ["string", "null"]},
        "minimum": {"type": "number", "minimum": 0}
      }
    }
  }
}
