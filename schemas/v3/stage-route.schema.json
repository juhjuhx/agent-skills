{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/juhjuhx/agent-skills/schemas/v3/stage-route.schema.json",
  "title": "Agent Skills Matrix v3 StageRoute",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "route_id",
    "task_id",
    "stage",
    "registry_epoch",
    "status",
    "selected_skills",
    "role_assignments",
    "adapter",
    "model_profile",
    "granted_capabilities",
    "budget_envelope",
    "alternatives",
    "route_reasons",
    "evidence_required"
  ],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schemaVersion"},
    "route_id": {"$ref": "common.schema.json#/$defs/recordId"},
    "task_id": {"$ref": "common.schema.json#/$defs/recordId"},
    "stage": {"$ref": "common.schema.json#/$defs/stage"},
    "registry_epoch": {"$ref": "common.schema.json#/$defs/recordId"},
    "status": {
      "type": "string",
      "enum": ["SKILLS_SELECTED", "NO_SKILL_NEEDED"]
    },
    "selected_skills": {
      "type": "array",
      "items": {"$ref": "#/$defs/selectedSkill"},
      "uniqueItems": true
    },
    "role_assignments": {
      "type": "array",
      "items": {"$ref": "#/$defs/roleAssignment"},
      "uniqueItems": true
    },
    "adapter": {"$ref": "common.schema.json#/$defs/runtimeId"},
    "model_profile": {"$ref": "common.schema.json#/$defs/recordId"},
    "granted_capabilities": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/capability"},
      "uniqueItems": true
    },
    "budget_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permission_level"],
      "properties": {
        "permission_level": {"$ref": "common.schema.json#/$defs/permissionLevel"},
        "max_input_tokens": {"type": "integer", "minimum": 0},
        "max_output_tokens": {"type": "integer", "minimum": 0},
        "max_tool_calls": {"type": "integer", "minimum": 0},
        "max_parallel_agents": {"type": "integer", "minimum": 0}
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill_id", "reason"],
        "properties": {
          "skill_id": {"$ref": "common.schema.json#/$defs/recordId"},
          "reason": {"$ref": "common.schema.json#/$defs/shortString"}
        }
      }
    },
    "route_reasons": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "common.schema.json#/$defs/shortString"}
    },
    "routing_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_count",
        "filtered_count",
        "eligible_count",
        "selected_count",
        "required_roles",
        "role_coverage",
        "duplicate_role_pressure",
        "context_bytes_estimate",
        "body_files_loaded",
        "body_bytes_loaded",
        "tool_requirements",
        "trust_blocks",
        "relationship_effects",
        "metadata_records_inspected",
        "selected_candidates",
        "rejected_candidates",
        "deep_understanding"
      ],
      "properties": {
        "candidate_count": {"type": "integer", "minimum": 0},
        "filtered_count": {"type": "integer", "minimum": 0},
        "eligible_count": {"type": "integer", "minimum": 0},
        "selected_count": {"type": "integer", "minimum": 0},
        "required_roles": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/role"},
          "uniqueItems": true
        },
        "role_coverage": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/role"},
          "uniqueItems": true
        },
        "duplicate_role_pressure": {"type": "integer", "minimum": 0},
        "context_bytes_estimate": {"type": "integer", "minimum": 0},
        "body_files_loaded": {"type": "integer", "minimum": 0},
        "body_bytes_loaded": {"type": "integer", "minimum": 0},
        "tool_requirements": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/shortString"},
          "uniqueItems": true
        },
        "trust_blocks": {"type": "integer", "minimum": 0},
        "relationship_effects": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/shortString"},
          "uniqueItems": true
        },
        "metadata_records_inspected": {"type": "integer", "minimum": 0},
        "selected_candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/selectedCandidate"}
        },
        "rejected_candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/rejectedCandidate"}
        },
        "deep_understanding": {"$ref": "#/$defs/deepUnderstanding"},
        "negative_signal_effects": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/shortString"},
          "uniqueItems": true
        },
        "role_saturation": {"$ref": "#/$defs/roleSaturation"},
        "marginal_cost_effects": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/shortString"},
          "uniqueItems": true
        },
        "catalog_snapshot": {"$ref": "#/$defs/catalogSnapshot"},
        "timings_ms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "json_parse_ms": {"type": "number", "minimum": 0},
            "schema_validation_ms": {"type": "number", "minimum": 0},
            "metadata_derivation_ms": {"type": "number", "minimum": 0},
            "graph_construction_ms": {"type": "number", "minimum": 0},
            "candidate_scoring_ms": {"type": "number", "minimum": 0},
            "total_route_ms": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "evidence_required": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/shortString"},
      "uniqueItems": true
    },
    "no_skill_reason": {"$ref": "common.schema.json#/$defs/shortString"},
    "reroute_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": {"type": "string", "enum": ["stage_boundary", "evidence_failure", "capability_change", "budget_change", "user_change"]},
        "reason": {"$ref": "common.schema.json#/$defs/shortString"},
        "evidence_refs": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/recordId"}
        }
      }
    },
    "previous_route_ref": {"$ref": "common.schema.json#/$defs/recordId"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "SKILLS_SELECTED"}}},
      "then": {
        "properties": {
          "selected_skills": {"minItems": 1},
          "role_assignments": {"minItems": 1}
        }
      },
      "else": {
        "required": ["no_skill_reason"],
        "properties": {
          "selected_skills": {"maxItems": 0},
          "role_assignments": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "selectedSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "role", "reason"],
      "properties": {
        "skill_id": {"$ref": "common.schema.json#/$defs/recordId"},
        "role": {"$ref": "common.schema.json#/$defs/role"},
        "reason": {"$ref": "common.schema.json#/$defs/shortString"}
      }
    },
    "roleAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "role"],
      "properties": {
        "skill_id": {"$ref": "common.schema.json#/$defs/recordId"},
        "role": {"$ref": "common.schema.json#/$defs/role"}
      }
    },
    "selectedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "role", "score", "components", "reason_codes"],
      "properties": {
        "skill_id": {"$ref": "common.schema.json#/$defs/recordId"},
        "role": {"$ref": "common.schema.json#/$defs/role"},
        "score": {"type": "number"},
        "components": {
          "type": "object",
          "additionalProperties": {"type": "number"}
        },
        "reason_codes": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/shortString"},
          "uniqueItems": true
        }
      }
    },
    "rejectedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_id", "reasons"],
      "properties": {
        "skill_id": {"$ref": "common.schema.json#/$defs/recordId"},
        "score": {"type": "number"},
        "reasons": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "common.schema.json#/$defs/shortString"},
          "uniqueItems": true
        }
      }
    },
    "deepUnderstanding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["OFF", "ELIGIBLE", "SELECTED", "UNAVAILABLE"]
        },
        "reason": {"$ref": "common.schema.json#/$defs/shortString"},
        "skill_id": {"$ref": "common.schema.json#/$defs/recordId"}
      }
    },
    "roleSaturation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_limit", "independent_review_required", "same_role_rejections"],
      "properties": {
        "review_limit": {"type": "integer", "minimum": 1, "maximum": 3},
        "independent_review_required": {"type": "boolean"},
        "same_role_rejections": {
          "type": "array",
          "items": {"$ref": "common.schema.json#/$defs/shortString"},
          "uniqueItems": true
        }
      }
    },
    "catalogSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "registry_epoch", "overlay_digest", "metadata_records", "metadata_bytes", "body_files_loaded", "reused"],
      "properties": {
        "snapshot_id": {"$ref": "common.schema.json#/$defs/recordId"},
        "registry_epoch": {"$ref": "common.schema.json#/$defs/recordId"},
        "overlay_digest": {"$ref": "common.schema.json#/$defs/digest"},
        "metadata_records": {"type": "integer", "minimum": 0},
        "metadata_bytes": {"type": "integer", "minimum": 0},
        "body_files_loaded": {"type": "integer", "minimum": 0},
        "reused": {"type": "boolean"}
      }
    }
  }
}
