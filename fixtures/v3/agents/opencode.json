{
  "schema_version": "3.0",
  "runtime_id": "opencode",
  "runtime_name": "OpenCode",
  "manifest_version": "fixture-1.0",
  "instruction_surfaces": {
    "persistent": {
      "paths": ["$AGENT_HOME/AGENTS.md"],
      "purposes": ["invariants", "routing-bootstrap", "context-policy"]
    },
    "session": ["$AGENT_HOME/.config/opencode/session.json"]
  },
  "skill_discovery": {
    "native_paths": ["$AGENT_HOME/.config/opencode/skills"],
    "lazy_loading": true,
    "compatibility_paths": ["$AGENT_HOME/skills"],
    "selected_refs_only": true
  },
  "commands": {"supported": true, "definitions": [{"id": "opencode-command", "purpose": "Native command"}]},
  "subagents": {"supported": true, "definitions": [{"id": "opencode-agent", "purpose": "Per-agent work"}]},
  "plugins": {"supported": true, "definitions": [{"id": "opencode-plugin", "purpose": "Packaged extension"}]},
  "hooks": {"supported": false},
  "mcp": {"supported": true, "lazy_loading": true, "schema_cost_tracked": true, "server_refs": ["filesystem"]},
  "permissions": {"policy_gated": true, "supports_profiles": true, "declared_scopes": ["workspace-read", "workspace-write", "MCP"]},
  "sandbox": {"supported": true, "modes": ["read-only", "workspace-write"]},
  "capabilities": {
    "editing": true,
    "browser": false,
    "subagents": true,
    "sandbox": true,
    "MCP": true,
    "structured_output": true,
    "parallelism": true,
    "native_learning": false,
    "model_selection": true,
    "reasoning_effort": true,
    "long_context": true,
    "multimodal": false
  },
  "model_selection": {"profile_based": true, "per_agent": true, "universal_model_ids": false},
  "reasoning_effort": {"native": true, "artifact_contract": true, "levels": ["low", "medium", "high"]},
  "parallelism": {"supported": true, "max_parallel": 2, "requires_disjoint_write_set": true},
  "context_behavior": {
    "static_prompt_prefix": "stable",
    "dynamic_runtime_context": "lazy",
    "tool_schema_budget": "tracked",
    "tool_ordering": "stable",
    "cache_stability": "stable-prefix"
  },
  "generated_config": {"supported": true, "outputs": ["$AGENT_HOME/generated/opencode.json"], "records_provenance": true},
  "security_constraints": ["Universal routing does not contain OpenCode model IDs.", "MCP schema cost is part of the context budget."]
}
