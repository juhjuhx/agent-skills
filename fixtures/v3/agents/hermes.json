{
  "schema_version": "3.0",
  "runtime_id": "hermes",
  "runtime_name": "Hermes",
  "manifest_version": "fixture-1.0",
  "instruction_surfaces": {
    "persistent": {
      "paths": ["$AGENT_HOME/HERMES.md"],
      "purposes": ["project-context", "routing-bootstrap"]
    },
    "session": ["$AGENT_HOME/.hermes/session.json"]
  },
  "skill_discovery": {
    "native_paths": ["$AGENT_HOME/.hermes/skills"],
    "lazy_loading": true,
    "compatibility_paths": ["$AGENT_HOME/skills"],
    "selected_refs_only": true
  },
  "commands": {"supported": true, "definitions": [{"id": "learn", "purpose": "Distill a learning proposal"}]},
  "subagents": {"supported": true, "definitions": [{"id": "hermes-agent", "purpose": "Long-running coordination"}]},
  "plugins": {"supported": true, "definitions": [{"id": "hermes-plugin", "purpose": "Packaged extension"}]},
  "hooks": {"supported": true, "definitions": [{"id": "learning-hook", "purpose": "Capture observable artifacts"}]},
  "mcp": {"supported": true, "lazy_loading": true, "schema_cost_tracked": true, "server_refs": []},
  "permissions": {"policy_gated": true, "supports_profiles": true, "declared_scopes": ["workspace-read", "workspace-write", "MCP"]},
  "sandbox": {"supported": true, "modes": ["read-only", "workspace-write"]},
  "capabilities": {
    "editing": true,
    "browser": false,
    "subagents": true,
    "sandbox": true,
    "MCP": true,
    "structured_output": true,
    "parallelism": true,
    "native_learning": true,
    "model_selection": true,
    "reasoning_effort": true,
    "long_context": true,
    "multimodal": false
  },
  "model_selection": {"profile_based": true, "per_agent": true, "universal_model_ids": false},
  "reasoning_effort": {"native": true, "artifact_contract": true, "levels": ["low", "medium", "high"]},
  "parallelism": {"supported": true, "max_parallel": 3, "requires_disjoint_write_set": true},
  "context_behavior": {
    "static_prompt_prefix": "stable",
    "dynamic_runtime_context": "lazy",
    "tool_schema_budget": "tracked",
    "tool_ordering": "runtime",
    "cache_stability": "best-effort"
  },
  "generated_config": {"supported": true, "outputs": ["$AGENT_HOME/generated/hermes.json"], "records_provenance": true},
  "security_constraints": ["Learned skills remain proposals until policy promotion.", "Cross-agent imports remain quarantined until evaluated."]
}
