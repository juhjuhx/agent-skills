{
  "schema_version": "3.0",
  "runtime_id": "zcode",
  "runtime_name": "ZCode",
  "manifest_version": "fixture-1.0",
  "instruction_surfaces": {
    "persistent": {
      "paths": ["$AGENT_HOME/AGENTS.md"],
      "purposes": ["invariants", "routing-bootstrap", "context-policy"]
    },
    "session": ["$AGENT_HOME/.zcode/session.json"]
  },
  "skill_discovery": {
    "native_paths": ["$AGENT_HOME/.zcode/skills"],
    "lazy_loading": true,
    "compatibility_paths": ["$AGENT_HOME/skills"],
    "selected_refs_only": true
  },
  "commands": {"supported": true, "definitions": [{"id": "zcode-command", "purpose": "Native command"}]},
  "subagents": {"supported": true, "definitions": [{"id": "zcode-subagent", "purpose": "Per-subagent model and permissions"}]},
  "plugins": {"supported": true, "definitions": [{"id": "zcode-plugin", "purpose": "Bundle skill, command, subagent, and MCP"}]},
  "hooks": {"supported": true, "definitions": [{"id": "zcode-hook", "purpose": "Lifecycle enforcement"}]},
  "mcp": {"supported": true, "lazy_loading": true, "schema_cost_tracked": true, "server_refs": []},
  "permissions": {"policy_gated": true, "supports_profiles": true, "declared_scopes": ["workspace-read", "workspace-write", "MCP"]},
  "sandbox": {"supported": true, "modes": ["read-only", "workspace-write"]},
  "capabilities": {
    "editing": true,
    "browser": false,
    "subagents": true,
    "sandbox": true,
    "MCP": true,
    "structured_output": true,
    "parallelism": true,
    "native_learning": false,
    "model_selection": true,
    "reasoning_effort": true,
    "long_context": true,
    "multimodal": false
  },
  "model_selection": {"profile_based": true, "per_agent": true, "universal_model_ids": false},
  "reasoning_effort": {"native": true, "artifact_contract": true, "levels": ["low", "medium", "high"]},
  "parallelism": {"supported": true, "max_parallel": 4, "requires_disjoint_write_set": true},
  "context_behavior": {
    "static_prompt_prefix": "stable",
    "dynamic_runtime_context": "lazy",
    "tool_schema_budget": "tracked",
    "tool_ordering": "stable",
    "cache_stability": "stable-prefix"
  },
  "generated_config": {"supported": true, "outputs": ["$AGENT_HOME/generated/zcode.json"], "records_provenance": true},
  "security_constraints": ["ZCode is the runtime; GLM is only a model profile.", "Plugin declarations never grant permissions."]
}
