  "supported_boundaries": [
    "after_prepared",
    "after_staging",
    "after_create",
    "after_update",
    "before_ownership",
    "after_ownership",
    "before_verify"
  ],
  "forbidden": [
    "REAL_HOME",
    "RUNTIME_CONFIG",
    "AUTH_STATE",
    "MODEL_INVOCATION",
    "FORCE_OR_ADOPT",
