{
  "schema_version": "3.0",
  "apply_contract_version": "1.0",
  "fixture_kind": "VIRTUAL_HOME_ONLY",
  "runtime_id": "claude-code",
  "runtime_version": "2.1.235",
  "scope": "USER",
