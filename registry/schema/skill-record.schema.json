{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agent-skills registry record",
  "type": "object",
  "required": [
    "id",
    "name",
    "sha256",
    "license",
    "status",
    "visibility",
    "risk_level"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "category": { "type": "array", "items": { "type": "string" } },
    "source_repo": { "type": ["string", "null"] },
    "source_commit": { "type": ["string", "null"] },
    "license": {
      "type": "string",
      "enum": [
        "MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "GPL-3.0",
        "LGPL-3.0", "MPL-2.0", "ISC", "Unlicense", "0BSD", "proprietary",
        "unknown"
      ]
    },
    "license_notice_retained": { "type": "boolean" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "relative_path": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "compatible_hosts": { "type": "array", "items": { "type": "string" } },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "triggers": { "type": "array", "items": { "type": "string" } },
    "status": {
      "type": "string",
      "enum": [
        "candidate", "approved_public", "approved_private", "quarantined",
        "deprecated", "rejected"
      ]
    },
    "visibility": { "type": "string", "enum": ["public", "private"] },
    "risk_level": {
      "type": "string",
      "enum": ["unreviewed", "low", "medium", "high", "blocked"]
    },
    "provenance": { "type": "object" },
    "generation": { "type": ["integer", "null"], "minimum": 0 },
    "parent_skills": { "type": "array", "items": { "type": "string" } },
    "source_provenance": { "type": "string" },
    "changes": { "type": "string" },
    "test_cases": { "type": "array", "items": { "type": "string" } },
    "baseline_score": { "type": ["number", "null"] },
    "new_score": { "type": ["number", "null"] },
    "acceptance_reason": { "type": "string" },
    "rollback_version": { "type": ["string", "null"] },
    "integrity": { "type": ["string", "null"] },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": true
}
